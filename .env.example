# biblioteca-libros: copia este archivo a .env y rellenalo con TUS valores. sembrar.mts lo lee con --env-file.
# Solo hace falta para sembrar; libros.mjs no lee ningun .env.
#
# GOOGLE_BOOKS_API_KEY y GROQ_API_KEY: solo si siembras con datos reales. Si no las tienes,
# `node --env-file=.env sembrar.mts --respaldo` no las necesita.
GOOGLE_BOOKS_API_KEY=
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-20b
CONSULTA=ciencia ficcion

# El sub (no el correo) de tus dos usuarios de Cognito: el claim "sub" del payload de su access token.
SUB_LECTOR=
SUB_INVITADO=
